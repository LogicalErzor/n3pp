# # 2. Create configs (once)
# doas mkdir -p /etc/wireplumber/wireplumber.conf.d
# doas mkdir -p /etc/pipewire/pipewire.conf.d

# doas sh -c 'cat > /etc/wireplumber/wireplumber.conf.d/50-bluetooth.conf << "EOF"
# monitor.bluez.properties = {
#   bluez5.enable-sbc-xq = true
#   bluez5.enable-msbc = true
#   bluez5.enable-hw-volume = true
# }
# EOF'

# doas sh -c 'cat > /etc/wireplumber/wireplumber.conf.d/51-force-bluez.conf << "EOF"
# wireplumber.profiles = {
#   main = {
#     monitor.bluez = required
#   }
# }
# EOF'

# # 3. Create null sink so Bluetooth has somewhere to route audio (until real audio works)
# doas sh -c 'cat > /etc/pipewire/pipewire.conf.d/99-null-sink.conf << "EOF"
# context.objects = [
