package() {
	for _i in $_files; do
		install -Dm644 "$srcdir/$_i" "$pkgdir"/lib/firmware/"$_i"
	done
	
	install -Dm644 "$srcdir/WCNSS_qcom_wlan_nv.bin" "$pkgdir"/lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin

	for _i in $_qcom_files; do
		install -Dm644 "$srcdir/$_i" "$pkgdir"/lib/firmware/qcom/msm8960/"$_i"
	done

	install -Dm644 "$srcdir/a2220.bin" "$pkgdir"/lib/firmware/audience/a2220.bin

	# iw reg set US
	# # List available networks (if scan works)
	# nmcli device wifi list
